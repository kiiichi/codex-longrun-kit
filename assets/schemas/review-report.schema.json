{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Longrun review report",
  "type": "object",
  "required": [
    "reviewer_lane",
    "findings"
  ],
  "properties": {
    "reviewer_lane": {
      "type": "string"
    },
    "base_commit": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "claim"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "info"
            ]
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "affected_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_human_decision": {
            "type": "boolean"
          }
        }
      }
    }
  }
}