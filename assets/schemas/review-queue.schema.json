{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Longrun review queue",
  "type": "object",
  "required": [
    "schema_version",
    "tickets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "base_commit": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tickets": {
      "type": "array"
    },
    "duplicates": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "human_decisions_needed": {
      "type": "array"
    }
  }
}